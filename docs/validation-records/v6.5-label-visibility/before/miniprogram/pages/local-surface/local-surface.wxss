.local-surface-page{max-width:600px;margin:0 auto;padding:10px 14px calc(12px + env(safe-area-inset-bottom));box-sizing:border-box}.heading{display:flex;align-items:center;justify-content:space-between;min-height:32px;font-weight:600;font-size:18px}.control{margin:0;border-radius:9px;background:#e3eee9;color:#315e50;font-size:14px;line-height:22px;padding:10px 12px;min-width:0;box-sizing:border-box}.control::after{border:0}.control[disabled]{color:#9daaa4;background:#edf1ee}.link{font-size:12px;background:transparent;padding:10px 2px}.switch-row{display:flex;gap:4px;background:#e3ebe5;border-radius:11px;padding:3px;margin:6px 0}.tab{flex:1;background:transparent}.tab.active{background:#fff;color:#215e4a;font-weight:600}.status{min-height:22px;font-size:12px;color:#62796d;margin:6px 0}.region-row{white-space:nowrap;margin-bottom:5px}.region-items{display:flex;gap:6px}.chip{font-size:12px;padding:5px 10px}.selected{background:#d1e6dc;color:#195640}.local-surface-stage{display:flex;gap:6px;min-height:280px}.canvas-area{flex:1;min-width:0;height:100%}.label-rail{width:66px;flex:0 0 66px}.rail-content{position:relative}.nerve-label{position:absolute;width:64px;border-left:3px solid #629c83;background:#fff;padding:4px 3px;font-size:13px;line-height:18px;min-height:44px}.nerve-label.selected{background:#d8e9df}.ratio{display:block;font-size:10px;color:#5e786c}.legend{display:flex;justify-content:space-between;font-size:11px;color:#708377;margin:6px 1px}.view-tools{display:flex;gap:4px}.subtle{flex:1;background:transparent;font-size:12px;padding:8px 1px}.count{font-size:12px;color:#557364;padding:5px 0}.toolbar{display:flex;gap:7px}.toolbar .control{flex:1;min-height:44px}.primary{background:#236b57;color:#fff}.message{font-size:13px;padding:8px 0;color:#95573f}.reference-note{font-size:12px;color:#75857d;line-height:1.6;margin-top:10px}.coverage{font-size:13px;padding:8px 0;color:#355c4d}.return-link{margin-top:10px;background:transparent;font-size:12px}.error{padding:20px;color:#8b573c}.info-mask{position:fixed;inset:0;background:rgba(24,42,35,.35);z-index:100;display:flex;align-items:flex-end}.info-sheet{background:#f5f8f7;border-radius:18px 18px 0 0;padding:16px 20px calc(20px + env(safe-area-inset-bottom));width:100%;box-sizing:border-box}.info-scroll{max-height:55vh;font-size:13px;color:#546e60}.info-scroll view{margin:14px 0}.source{display:block;overflow-wrap:anywhere;font-size:11px}
