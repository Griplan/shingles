# Python / local virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Node / TypeScript output generated by WeChat developer tools
node_modules/
miniprogram_npm/
miniprogram/**/*.js
miniprogram/**/*.js.map
*.tsbuildinfo

# Secrets / developer-specific WeChat settings
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.json
project.private.config.json
.idea/
.vscode/
.DS_Store

# Sensitive medical data must stay outside the repository
data/private/
data/patients/
data/uploads/
private-data/
uploads/

# Optional AI weights and experiment bulk output
ai/models/*
!ai/models/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.h5
*.hdf5
ai/experiments/outputs/
ai/experiments/inputs/

# Runtime files (reviewed validation evidence is kept as .txt)
*.log
*.pid
coverage.xml
