[Unit]
Description=Zhiluo Zhihui controlled backend (independent)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=dermatome
Group=dermatome
WorkingDirectory=/srv/dermatome-mapper
EnvironmentFile=/srv/dermatome-mapper/config/service.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=PYTHONPATH=/srv/dermatome-mapper:/srv/dermatome-mapper/backend:/srv/dermatome-mapper/ai/models/MobileSAM-source
ExecStart=/srv/dermatome-mapper/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 1 --no-access-log --limit-concurrency 12 --backlog 32 --timeout-keep-alive 5 --timeout-graceful-shutdown 50
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
KillMode=control-group
OOMPolicy=stop
CPUQuota=100%
CPUWeight=20
MemoryAccounting=yes
MemoryHigh=1280M
MemoryMax=1536M
MemorySwapMax=0
TasksMax=64
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/dermatome-mapper/runtime /srv/dermatome-mapper/logs
InaccessiblePaths=/srv/acupuncture /srv/dermatome-preflight-20261101-p0
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectControlGroups=true
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=50

[Install]
WantedBy=multi-user.target
