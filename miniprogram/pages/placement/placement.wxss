page{background:#f5f8f7;color:#234d43}.placement-page{padding:16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));max-width:850rpx;margin:auto}
.heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;min-height:44px;font-size:28rpx}.instruction{font-size:30rpx;margin:6rpx 0 16rpx}
.body-stage{position:relative;height:50vh;min-height:260px;max-height:620px}.overlay{position:absolute;inset:0;z-index:2;display:block}
button{font-size:28rpx;line-height:1.4;min-height:44px;padding:10px 12px;border-radius:12rpx;color:#285a4d;background:#e6eeea;display:flex;align-items:center;justify-content:center;margin:0}button::after{border:0}button.primary{background:#236b57;color:white}button[disabled]{background:#edf0ee;color:#8d9c96}
button.text-button{background:transparent;font-size:26rpx;padding:8px 10px}.focus{margin:auto}.slider-label{display:flex;justify-content:space-between;font-size:27rpx;margin-top:10rpx}slider{margin:12rpx 12rpx 18rpx}.actions{display:flex;gap:16rpx;margin-top:16rpx}.actions button{flex:1}.actions .primary{flex:2}.note{font-size:23rpx;line-height:1.5;color:#7a8d84;margin-top:18rpx}.warning{font-size:26rpx;line-height:1.6;color:#975133;padding:12rpx 0}.saved{width:100%;margin-top:18rpx}
