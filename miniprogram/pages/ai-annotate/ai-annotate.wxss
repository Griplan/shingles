page{background:#f5f8f7;color:#234d43}
.ai-page{padding:16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));max-width:850rpx;margin:auto}
.heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;min-height:44px;font-size:28rpx;margin-bottom:12rpx}
.muted{color:#687f77;font-size:26rpx}
.photo-stage{height:50vh;min-height:240px;max-height:620px}
.placeholder{height:100%;display:flex;flex-direction:column;gap:20rpx;align-items:center;justify-content:center;background:#eaf0ed;border-radius:16rpx;text-align:center;padding:0 24rpx;box-sizing:border-box}
.placeholder-title{font-size:32rpx}
.ai-page button{font-size:28rpx;line-height:1.4;min-height:44px;padding:10px 12px;border-radius:12rpx;color:#285a4d;background:#e6eeea;display:flex;justify-content:center;align-items:center;margin:0}
.ai-page button::after{border:0}
.ai-page button.primary{background:#236b57;color:#fff}
.ai-page button.active{background:#d6e8df;box-shadow:inset 0 0 0 1px #236b57}
.ai-page button[disabled]{color:#8d9c96;background:#edf0ee;box-shadow:none}
.ai-page button.text-button{background:transparent;font-size:26rpx;padding:8px 10px}
.heading .text-button{padding-right:0}
.row,.upload-actions{display:flex;gap:12rpx;margin-top:12rpx}
.row button,.upload-actions button{flex:1;min-width:0}
.upload-actions{margin-top:24rpx}
.upload-actions .primary{flex:2}
.status{font-size:28rpx;line-height:1.6;margin-top:20rpx;min-height:44rpx}
.confirm{width:100%;margin-top:18rpx!important}
.result-actions,.footer{display:flex;justify-content:center;gap:24rpx}
.result-actions{margin-top:6rpx}
.fine-entry{width:100%;color:#687f77!important}
.adjustment{margin-top:12rpx;padding-top:4rpx}
.warning,.notice{color:#87552c;font-size:25rpx;line-height:1.6;padding:10rpx 0}
.footer{margin-top:16rpx;flex-wrap:wrap}
.privacy{margin-top:8rpx;text-align:center;font-size:23rpx;color:#7a8d84}
.privacy .text-button{font-size:23rpx;color:#687f77;display:inline-flex}
.brush-size{display:flex;align-items:center;font-size:26rpx;gap:12rpx;min-height:44px}
.brush-size .brush-slider{flex:1;margin:8px}
.result-actions .fine-entry{width:auto;flex:1}
