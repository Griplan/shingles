.special-page{max-width:600px;margin:0 auto;padding:28px 20px calc(24px + env(safe-area-inset-bottom));box-sizing:border-box}.title{font-size:22px;font-weight:600;margin-bottom:8px}.hint{font-size:14px;color:#657d73}.choices{display:flex;gap:12px;margin:24px 0}.choice{flex:1;margin:0;padding:24px 8px;border-radius:14px;background:#e3eee9;color:#245d4c;font-size:20px;font-weight:600;line-height:1.5}.choice text{display:block;margin-top:8px;font-size:12px;font-weight:400;color:#647d71}.choice::after,.back::after{border:0}.back{margin:24px 0 0;padding:10px;background:transparent;color:#356b57;font-size:14px}.message{font-size:13px;color:#98563b}
