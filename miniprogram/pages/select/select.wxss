page {
  height: 100%;
  overflow: hidden;
  background: var(--ui-bg-stage);
}

.body-page {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  background: var(--ui-bg-stage);
}

.browse-workspace {
  flex: 1 1 0;
  min-width: 0;
  min-height: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 手机端类型 A：上方人体画布自动吃满剩余高度（~68%~72%） ===== */
.model-stage {
  position: relative;
  z-index: 1;
  flex: 1 1 0;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.stage-header {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 14px 2px;
  box-sizing: border-box;
}

.stage-title-group {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.body-title {
  font-size: 16px;
  line-height: 22px;
  font-weight: 600;
  color: var(--ui-text-1);
  white-space: nowrap;
}

.stage-badge {
  flex-shrink: 0;
  padding: 2px 8px;
  border-radius: 999px;
  background: #FFFFFF;
  border: 1px solid #E5E9F0;
  font-size: 11px;
  line-height: 16px;
  color: #64748B;
  white-space: nowrap;
}

.utility-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
}

/* 正背面分段胶囊：独立成行置于画布上方 */
.stage-switch-row {
  position: relative;
  z-index: 2;
  flex: 0 0 auto;
  display: flex;
  justify-content: center;
  margin: 2px auto 4px;
}

.view-segmented {
  width: 196px;
}

.view-tab {
  flex: 1 1 0;
}

/* 中间纯净画布区 */
.canvas-viewport {
  position: relative;
  flex: 1 1 0;
  height: 0;
  min-width: 0;
  min-height: 0;
  width: 100%;
  overflow: hidden;
}

.canvas-area {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
}

.canvas-area > body-canvas {
  display: block;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
}

/* 底部微信息条 */
.stage-bottom-bar {
  flex: 0 0 auto;
  height: 26px;
  padding: 0 14px 4px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  font-size: 11px;
  color: #64748B;
}

.stage-bottom-tag {
  white-space: nowrap;
}

.stage-bottom-hint {
  color: #86909C;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ===== 手机端类型 A：下方紧凑操作板（贴合内容高度，零多余留白） ===== */
.inspector-panel {
  position: relative;
  z-index: 2;
  flex: 0 0 auto;
  height: auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #FFFFFF;
  border-top: 1px solid #E5E9F0;
  border-radius: 16px 16px 0 0;
  box-sizing: border-box;
}

.inspector-content {
  width: 100%;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* 手机端隐藏宽屏区段标题，保持底部操作板极致紧凑 */
.inspector-wide-header {
  display: none;
}

.status-strip {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
}

.selection-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  max-width: 100%;
  padding: 3px 10px;
  border-radius: 999px;
  background: #EBF3FF;
  border: 1px solid rgba(22, 93, 255, 0.25);
  color: #165DFF;
}

.selection-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #165DFF;
  flex-shrink: 0;
}

.selection-name {
  font-size: 12px;
  font-weight: 600;
  line-height: 18px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.interaction-hint {
  font-size: 12px;
  line-height: 18px;
  color: var(--ui-text-2);
}

.focused-actions {
  width: 100%;
}

/* 手机端紧凑全宽横条卡片（高 60px，间距 8px，总高 ≤ 155px + 安全区） */
.action-cards {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.action-card {
  width: 100% !important;
  max-width: none !important;
  min-width: 0;
  margin: 0 !important;
  padding: 10px 14px;
  height: 60px;
  min-height: 60px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 12px;
  text-align: left;
  line-height: 1.3;
  border-radius: 10px;
  background: #FFFFFF;
  border: 1px solid #E5E9F0;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}

.action-card-primary {
  border-color: rgba(22, 93, 255, 0.32);
}

.action-card.is-disabled {
  background: #F1F5F9;
  border-color: #E2E8F0;
  opacity: 0.6;
  pointer-events: none;
}

.card-icon-wrap {
  flex: 0 0 38px;
  width: 38px;
  height: 38px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.card-icon-primary {
  background: #165DFF;
}

.card-icon-secondary {
  background: #EBF3FF;
  border: 1px solid rgba(22, 93, 255, 0.18);
}

.icon-manual {
  position: relative;
  width: 17px;
  height: 17px;
  border: 1.5px solid #FFFFFF;
  border-radius: 4px;
  box-sizing: border-box;
}

.icon-manual-dot {
  position: absolute;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #FFFFFF;
}

.dot-tl { top: -2.5px; left: -2.5px; }
.dot-tr { top: -2.5px; right: -2.5px; }
.dot-b { bottom: -2.5px; left: 50%; transform: translateX(-50%); }

.icon-ai {
  position: relative;
  width: 17px;
  height: 17px;
  border: 1.5px solid #165DFF;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.icon-ai-core {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  border: 1.5px solid #165DFF;
  box-sizing: border-box;
}

.card-body {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.card-title {
  font-size: 15px;
  font-weight: 600;
  line-height: 20px;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-desc {
  font-size: 12px;
  font-weight: 400;
  line-height: 16px;
  color: #64748B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-arrow {
  flex: 0 0 auto;
  width: 7px;
  height: 7px;
  margin-right: 2px;
  border-top: 1.5px solid #CBD5E1;
  border-right: 1.5px solid #CBD5E1;
  transform: rotate(45deg);
}

.action-card-primary .card-arrow {
  border-color: #165DFF;
}

/* ===== 宽屏 / 折叠屏模式：左 50% + 右 50% 饱满铺开 ===== */
@media (min-width: 680px) and (min-height: 520px) {
  .browse-workspace {
    flex-direction: row;
    align-items: stretch;
  }

  .model-stage {
    flex: 50 1 0;
    width: 0;
    height: 100%;
    border-right: 1px solid #E5E9F0;
  }

  .stage-header {
    padding: 12px 20px 4px;
  }

  .stage-switch-row {
    margin: 4px auto 8px;
  }

  .view-segmented {
    width: 212px;
  }

  .stage-bottom-bar {
    height: 32px;
    padding: 0 20px 8px;
  }

  .inspector-panel {
    flex: 50 1 0;
    width: 0;
    height: 100%;
    border-top: none;
    border-radius: 0;
    overflow-y: auto;
  }

  .inspector-content {
    padding: 24px 24px calc(24px + env(safe-area-inset-bottom));
    gap: 14px;
  }

  .inspector-wide-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .inspector-kicker {
    font-size: 16px;
    font-weight: 600;
    line-height: 22px;
    color: #111827;
  }

  .inspector-wide-sub {
    font-size: 12px;
    line-height: 18px;
    color: #64748B;
  }

  .action-cards {
    gap: 14px;
  }

  .action-card {
    height: 86px;
    min-height: 86px;
    padding: 18px 18px;
    gap: 16px;
    border-radius: 12px;
  }

  .card-icon-wrap {
    flex: 0 0 46px;
    width: 46px;
    height: 46px;
    border-radius: 10px;
  }

  .card-title {
    font-size: 16px;
    line-height: 22px;
  }

  .card-desc {
    font-size: 13px;
    line-height: 18px;
  }
}

/* 矮横屏兜底 */
@media (max-height: 519px) {
  .model-stage {
    min-height: 160px;
  }
}

/* ===== 开发态坐标调试面板 ===== */
.debug-scroll {
  max-height: 36vh;
  margin-top: 8px;
}

.source-note {
  padding: 10px 0 4px;
  font-size: 11px;
  line-height: 1.6;
  color: var(--ui-text-3);
}

.home-link {
  display: inline;
  margin-left: 8px;
  color: var(--ui-primary);
}

.debug-panel {
  padding: 12px;
  border: 1px solid #E5E9F0;
  border-radius: 8px;
  background: var(--ui-bg-stage);
  font-size: 12px;
}

.debug-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 14px;
  font-weight: 600;
  color: var(--ui-text-1);
}

.debug-subtitle {
  margin-top: 4px;
  font-size: 11px;
  color: var(--ui-text-3);
}

.debug-status {
  margin: 10px 0;
  padding: 8px 10px;
  border-radius: 6px;
  background: #FFFBEB;
  color: #92400E;
}

.debug-valid {
  background: #EBF3FF;
  color: #165DFF;
}

.debug-row {
  display: flex;
  justify-content: space-between;
  margin: 6px 0;
  color: var(--ui-text-2);
  gap: 10px;
}

.debug-value {
  max-width: 64%;
  text-align: right;
  color: var(--ui-text-1);
  overflow-wrap: anywhere;
}

.debug-coordinates {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin: 8px 0;
  padding: 10px;
  background: #FFFFFF;
  border: 1px solid #E5E9F0;
  color: #165DFF;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
}

.debug-help {
  margin-top: 10px;
  color: var(--ui-text-3);
  font-size: 11px;
  line-height: 1.55;
}
