<view class="body-page">
  <view class="browse-layout">
    <view class="page-heading"><text class="body-title">选择病灶所在部位</text><view class="utility-actions"><view class="utility-link" aria-role="button" bindtap="openSpecialParts">特殊部位</view><view class="utility-link" aria-role="button" bindtap="showSource">说明</view><view wx:if="{{debugAllowed}}" class="utility-link" aria-role="button" bindtap="toggleDeveloper">开发调试</view></view></view>
    <view class="interaction-hint">{{debugEnabled ? '坐标调试中，人体点击暂不用于选择部位。' : selectionMessage || (mode === 'focused' ? '局部仅供查看，更换部位请返回全身或使用列表' : '轻触人体选择部位，再放大查看')}}</view>
    <view class="view-switch">
      <button class="body-button view-tab {{view === 'front' ? 'is-active' : ''}}" data-view="front" bindtap="switchView" aria-pressed="{{view === 'front'}}">正面</button>
      <button class="body-button view-tab {{view === 'back' ? 'is-active' : ''}}" data-view="back" bindtap="switchView" aria-pressed="{{view === 'back'}}">背面</button>
    </view>
    <view class="model-stage">
      <view class="orientation"><text>{{screenLeft}}</text><text>{{mode === 'focused' ? '局部预览' : '全身选择'}}</text><text>{{screenRight}}</text></view>
      <view class="canvas-area"><body-canvas view="{{view}}" selected-region="{{selectedRegion}}" zoom-region="{{zoomRegion}}" debug-enabled="{{debugEnabled}}" interaction-blocked="{{sheetOpen || infoOpen}}" layout-revision="{{layoutRevision}}" bind:regionprobe="onRegionProbe" bind:debugprobe="onDebugProbe" bind:viewportchange="onViewportChange"></body-canvas></view>
    </view>
    <view class="bottom-actions">
      <view class="selection-summary"><text class="selection-name">{{mode === 'focused' ? '正在查看：' : selectedRegion ? '已选：' : ''}}{{selectedRegion ? (view === 'front' ? '正面 · ' : '背面 · ') + selectedName : '尚未选择部位'}}</text><view wx:if="{{mode === 'overview'}}" class="list-entry" aria-role="button" bindtap="openRegionPicker">从列表选择</view></view>
      <view wx:if="{{mode === 'overview'}}" class="action-row"><button class="body-button primary-action {{!selectedRegion ? 'is-disabled' : ''}}" disabled="{{!selectedRegion}}" bindtap="zoomIn">放大查看</button></view>
      <view wx:else class="action-row"><button class="body-button secondary-action" bindtap="showFullBody">返回全身</button><button class="body-button primary-action" bindtap="openRegionPicker">更换部位</button></view>
      <view class="action-row annotation-entry"><button class="body-button primary-action" disabled="{{!selectedRegion || debugEnabled || infoOpen || sheetOpen}}" bindtap="startAnnotation">手动标注</button><button wx:if="{{aiAllowed}}" class="body-button secondary-action" disabled="{{!selectedRegion || debugEnabled || infoOpen || sheetOpen}}" bindtap="startAI">AI 辅助标注</button></view>
    </view>
  </view>
  <view wx:if="{{developerOpen}}" class="debug-panel">
    <view class="debug-heading"><text>坐标调试</text><switch checked="{{debugEnabled}}" bindchange="toggleDebug" color="#236b57" aria-label="坐标调试开关"></switch></view>
    <view class="debug-subtitle">{{debugEnabled ? "坐标调试中，人体点击暂不用于选择部位。" : "默认关闭；仅保留一个调试点，不记录病灶。"}}</view>
    <view class="debug-status {{probeStatus === 'valid' ? 'debug-valid' : ''}}">{{debugMessage}}</view>
    <view class="debug-row"><text>当前视图 / 显示模式</text><text class="debug-value">{{view}} / {{zoomRegion ? '局部放大' : '全身'}}</text></view>
    <view class="debug-row"><text>人体模板</text><text class="debug-value">{{modelId}} · {{modelVersion}}</text></view>
    <view class="debug-row"><text>当前区域 ID</text><text class="debug-value">{{selectedRegion || '未选择'}}</text></view>
    <view class="debug-row"><text>点击时屏幕 X / Y</text><text class="debug-value">{{screenX}} / {{screenY}}</text></view>
    <view class="debug-row"><text>点击时 Canvas X / Y</text><text class="debug-value">{{canvasX}} / {{canvasY}}</text></view>
    <view class="debug-coordinates"><text>标准坐标 X {{normalizedX}}</text><text>Y {{normalizedY}}</text></view>
    <view class="debug-row"><text>当前十字 Canvas X / Y</text><text class="debug-value">{{markerX}} / {{markerY}}</text></view>
    <view class="debug-row"><text>逻辑画布</text><text class="debug-value">{{logicalWidth}} × {{logicalHeight}}</text></view>
    <view class="debug-row"><text>Canvas CSS / DPR</text><text class="debug-value">{{cssWidth}} × {{cssHeight}} / {{dpr}}</text></view>
    <view class="debug-row"><text>物理像素</text><text class="debug-value">{{physicalWidth}} × {{physicalHeight}}</text></view>
    <view class="debug-row"><text>缩放倍数 / 比例</text><text class="debug-value">{{zoom}} / {{scale}}</text></view>
    <view class="debug-row"><text>偏移 X / Y</text><text class="debug-value">{{offsetX}} / {{offsetY}}</text></view>
    <view class="debug-help">屏幕与 Canvas 坐标单位为 CSS 像素，屏幕原点为页面可显示区域左上角。标准坐标无单位，范围 [0,1]。放大或复位后标准坐标不变；十字不在可见范围时隐藏。调试点击不改变所选区域。</view>
  </view>
  <view wx:if="{{developerOpen}}" class="source-note">粗粒度身体区域，不是医学皮节。素材来自 Commons，CC0。<navigator url="/pages/index/index" open-type="reLaunch" class="home-link">返回首页</navigator></view>
  <region-picker open="{{sheetOpen}}" view-label="{{view === 'front' ? '正面' : '背面'}}" regions="{{sheetRegions}}" selected="{{selectedRegion}}" candidates-only="{{candidateIds.length > 1}}" bind:choose="chooseFromList" bind:close="closeRegionPicker"></region-picker>
</view>
