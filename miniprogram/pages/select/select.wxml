<view class="body-page">
  <view class="browse-workspace">
    <!-- 左侧(宽屏50%) / 上方(手机 flex:1 吃满剩余空间)：纯净三段式临床解剖视口 -->
    <view class="model-stage ui-stage-grid">
      <!-- 1. 顶部控制条（移除冗余“完整人体”灰标，保持清爽） -->
      <view class="stage-header">
        <view class="stage-title-group">
          <text class="body-title">完整人体标注</text>
          <text wx:if="{{mode === 'focused'}}" class="stage-badge">局部预览</text>
        </view>
        <view class="utility-actions">
          <view class="ui-top-pill" hover-class="ui-hover-secondary" aria-role="button" bindtap="openSpecialParts">特殊部位</view>
        </view>
      </view>

      <!-- 2. 正背面分段胶囊：独立成行置于画布上方，绝不遮挡头部 -->
      <view class="stage-switch-row">
        <view class="ui-segmented view-segmented">
          <view
            class="ui-segmented-item view-tab {{view === 'front' ? 'is-active' : ''}}"
            hover-class="ui-hover-subtle"
            aria-role="button"
            data-view="front"
            catchtap="switchView"
            aria-pressed="{{view === 'front'}}"
          >正面</view>
          <view
            class="ui-segmented-item view-tab {{view === 'back' ? 'is-active' : ''}}"
            hover-class="ui-hover-subtle"
            aria-role="button"
            data-view="back"
            catchtap="switchView"
            aria-pressed="{{view === 'back'}}"
          >背面</view>
        </view>
      </view>

      <!-- 3. 中间纯净画布区（无遮挡） -->
      <view class="canvas-viewport">
        <view class="canvas-area">
          <body-canvas
            view="{{view}}"
            selected-region="{{selectedRegion}}"
            zoom-region="{{zoomRegion}}"
            debug-enabled="{{debugEnabled}}"
            interaction-blocked="{{sheetOpen || infoOpen}}"
            layout-revision="{{layoutRevision}}"
            bind:regionprobe="onRegionProbe"
            bind:debugprobe="onDebugProbe"
            bind:viewportchange="onViewportChange"
          ></body-canvas>
        </view>
      </view>

      <!-- 4. 底部微信息条（影像方位 + 极简提示） -->
      <view class="stage-bottom-bar" aria-hidden="true">
        <text class="stage-bottom-tag">{{screenLeft}}</text>
        <text class="stage-bottom-hint">轻触人体预选部位</text>
        <text class="stage-bottom-tag">{{screenRight}}</text>
      </view>
    </view>

    <!-- 右侧(宽屏50%) / 下方(手机贴合内容紧凑高度)：纯白临床操作面板 -->
    <view class="inspector-panel">
      <view class="inspector-content">
        <!-- 宽屏区段小标题（手机端隐藏以极致压缩底部高度） -->
        <view class="inspector-wide-header">
          <text class="inspector-kicker">开始标注</text>
          <text class="inspector-wide-sub">可在左侧轻触预选部位，或直接选择标注方式</text>
        </view>

        <!-- 动态状态条：仅在选中部位或有提示时显示 -->
        <view wx:if="{{(selectedRegion && mode === 'overview') || debugEnabled || selectionMessage || mode === 'focused'}}" class="status-strip">
          <view wx:if="{{selectedRegion && mode === 'overview'}}" class="selection-chip">
            <text class="selection-dot"></text>
            <text class="selection-name">{{view === 'front' ? '正面' : '背面'}} · {{selectedName}}</text>
          </view>
          <view wx:if="{{debugEnabled || selectionMessage || mode === 'focused'}}" class="interaction-hint" aria-live="polite">
            {{debugEnabled ? '坐标调试中，人体点击暂停。' : selectionMessage || (mode === 'focused' ? '局部查看中，返回全身后可继续标注。' : '')}}
          </view>
        </view>

        <view wx:if="{{mode === 'focused'}}" class="focused-actions">
          <button class="ui-btn ui-btn-secondary ui-btn-sm ui-btn-block" hover-class="ui-hover-secondary" bindtap="showFullBody">返回全身</button>
        </view>

        <!-- 临床功能卡片（采用 view 彻底杜绝微信 v2 button 184px 截断，100% 铺满） -->
        <view class="action-cards">
          <view
            class="action-card action-card-primary {{(debugEnabled || infoOpen || sheetOpen) ? 'is-disabled' : ''}}"
            hover-class="ui-hover-secondary"
            aria-role="button"
            bindtap="startAnnotation"
          >
            <view class="card-icon-wrap card-icon-primary" aria-hidden="true">
              <view class="icon-manual">
                <view class="icon-manual-dot dot-tl"></view>
                <view class="icon-manual-dot dot-tr"></view>
                <view class="icon-manual-dot dot-b"></view>
              </view>
            </view>
            <view class="card-body">
              <text class="card-title">手动标注</text>
              <text class="card-desc">在人体图谱上手动描点圈选</text>
            </view>
            <view class="card-arrow" aria-hidden="true"></view>
          </view>

          <view
            wx:if="{{aiAllowed}}"
            class="action-card action-card-secondary {{(debugEnabled || infoOpen || sheetOpen) ? 'is-disabled' : ''}}"
            hover-class="ui-hover-secondary"
            aria-role="button"
            bindtap="startAI"
          >
            <view class="card-icon-wrap card-icon-secondary" aria-hidden="true">
              <view class="icon-ai">
                <view class="icon-ai-core"></view>
              </view>
            </view>
            <view class="card-body">
              <text class="card-title">AI 辅助标注</text>
              <text class="card-desc">上传局部皮肤照片辅助识别范围</text>
            </view>
            <view class="card-arrow" aria-hidden="true"></view>
          </view>
        </view>

        <!-- 开发态调试面板（仅开发开关打开时在独立滚动区显示） -->
        <scroll-view wx:if="{{developerOpen}}" class="debug-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="debug-panel">
            <view class="debug-heading">
              <text>坐标调试</text>
              <switch checked="{{debugEnabled}}" bindchange="toggleDebug" color="#165DFF" aria-label="坐标调试开关"></switch>
            </view>
            <view class="debug-subtitle">{{debugEnabled ? "坐标调试中，人体点击暂不用于选择部位。" : "默认关闭；仅保留一个调试点，不记录病灶。"}}</view>
            <view class="debug-status {{probeStatus === 'valid' ? 'debug-valid' : ''}}">{{debugMessage}}</view>
            <view class="debug-row"><text>当前视图 / 显示模式</text><text class="debug-value ui-num">{{view}} / {{zoomRegion ? '局部放大' : '全身'}}</text></view>
            <view class="debug-row"><text>人体模板</text><text class="debug-value ui-num">{{modelId}} · {{modelVersion}}</text></view>
            <view class="debug-row"><text>当前区域 ID</text><text class="debug-value ui-num">{{selectedRegion || '未选择'}}</text></view>
            <view class="debug-row"><text>点击时屏幕 X / Y</text><text class="debug-value ui-num">{{screenX}} / {{screenY}}</text></view>
            <view class="debug-row"><text>点击时 Canvas X / Y</text><text class="debug-value ui-num">{{canvasX}} / {{canvasY}}</text></view>
            <view class="debug-coordinates ui-num"><text>标准坐标 X {{normalizedX}}</text><text>Y {{normalizedY}}</text></view>
            <view class="debug-row"><text>当前十字 Canvas X / Y</text><text class="debug-value ui-num">{{markerX}} / {{markerY}}</text></view>
            <view class="debug-row"><text>逻辑画布</text><text class="debug-value ui-num">{{logicalWidth}} × {{logicalHeight}}</text></view>
            <view class="debug-row"><text>Canvas CSS / DPR</text><text class="debug-value ui-num">{{cssWidth}} × {{cssHeight}} / {{dpr}}</text></view>
            <view class="debug-row"><text>物理像素</text><text class="debug-value ui-num">{{physicalWidth}} × {{physicalHeight}}</text></view>
            <view class="debug-row"><text>缩放倍数 / 比例</text><text class="debug-value ui-num">{{zoom}} / {{scale}}</text></view>
            <view class="debug-row"><text>偏移 X / Y</text><text class="debug-value ui-num">{{offsetX}} / {{offsetY}}</text></view>
            <view class="debug-help">屏幕与 Canvas 坐标单位为 CSS 像素，屏幕原点为页面可显示区域左上角。标准坐标无单位，范围 [0,1]。放大或复位后标准坐标不变；十字不在可见范围时隐藏。调试点击不改变所选区域。</view>
          </view>

          <view class="source-note">
            粗粒度身体区域，不是医学皮节。素材来自 Commons，CC0。
            <navigator url="/pages/index/index" open-type="reLaunch" class="home-link">返回首页</navigator>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <region-picker
    open="{{sheetOpen}}"
    view-label="{{view === 'front' ? '正面' : '背面'}}"
    regions="{{sheetRegions}}"
    selected="{{selectedRegion}}"
    candidates-only="{{candidateIds.length > 1}}"
    bind:choose="chooseFromList"
    bind:close="closeRegionPicker"
  ></region-picker>
</view>
