/* 通用 Token 与基础样式见 app.wxss */
.index-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.index-header {
  padding-top: 4px;
}

.index-card {
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
}

.index-features {
  font-size: 14px;
  font-weight: 500;
  color: var(--ui-text-1);
  line-height: 1.5;
}

.index-divider {
  height: 1px;
  margin: 12px 0;
  background: var(--ui-border);
}

.index-card-note {
  margin-top: 0;
}

.index-actions {
  margin-top: 20px;
}

.index-primary-cta {
  margin-top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 120ms ease;
}

.atlas-test-entry {
  margin-top: 12px;
  height: 40px;
  line-height: 40px;
  text-align: center;
  font-size: 13px;
  font-weight: 500;
  color: var(--ui-primary);
  border-radius: var(--ui-radius-md);
}

.index-privacy {
  margin-top: 16px;
}
