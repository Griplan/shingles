.atlas-page{padding:16rpx 24rpx 44rpx}.preview-warning{background:#fff1d8;color:#745627;padding:12rpx 20rpx;border-radius:12rpx;font-size:24rpx}.toolbar{display:flex;justify-content:space-between;align-items:center;gap:10rpx;margin:12rpx 0}.segments{display:flex;gap:8rpx}.segments button,.actions button{margin:0;padding:0 18rpx;background:#e7efeb;color:#31564a;font-size:24rpx;line-height:60rpx}.segments button.active{background:#236b57;color:#fff}.canvas-area{position:relative;height:57vh;min-height:340px;background:#fff;border-radius:18rpx;border:1rpx solid #e1e9e4;overflow:hidden}.canvas-area body-canvas{display:block;width:100%;height:100%}.side-guide{position:absolute;left:24rpx;right:24rpx;top:12rpx;display:flex;justify-content:space-between;font-size:21rpx;color:#758780;pointer-events:none}.controls{font-size:25rpx}.region-selector{display:flex;justify-content:space-between;margin-top:16rpx;background:#fff;border:1rpx solid #cbdcd3;padding:14rpx 22rpx;border-radius:12rpx;color:#204e3e}.label-switch{display:flex;align-items:center;font-size:22rpx;white-space:nowrap}.label-switch switch{transform:scale(.65);transform-origin:right center;width:88rpx}.coverage,.message{font-size:22rpx;color:#61766c;margin-top:8rpx}.source-toggle{padding:18rpx 0;color:#236b57}.source-info{font-size:22rpx;line-height:1.65;background:#fff;border-radius:12rpx;padding:20rpx;word-break:break-all}.source-info view{margin:8rpx 0}.back-link{color:#315f4e;padding-top:16rpx;font-size:24rpx}
.group-tabs{margin-top:16rpx;flex-wrap:wrap}.group-tabs button{font-size:22rpx;padding:0 14rpx}.face-options{display:flex;flex-direction:column;gap:8rpx;margin-top:12rpx}.face-options button{margin:0;text-align:left;padding:0 18rpx;background:#edf3ef;color:#31564a;font-size:24rpx;line-height:56rpx}.face-options button.active{background:#236b57;color:#fff}.local-focus button{padding:0 14rpx;font-size:23rpx}
