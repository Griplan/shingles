:host {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.canvas-shell {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  background: var(--ui-bg-stage, #F4F6F9);
}

.body-canvas {
  position: relative;
  z-index: 2;
  display: block;
  width: 100%;
  height: 100%;
}

.body-fallback {
  position: absolute;
  z-index: 1;
  display: block;
  max-width: none;
  pointer-events: none;
}

.canvas-message {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 18px;
  box-sizing: border-box;
  color: var(--ui-text-2, #4B5563);
  text-align: center;
  background: var(--ui-bg-stage, #F4F6F9);
  font-size: 13px;
}

.canvas-error {
  color: #92400E;
}

.retry-button {
  margin-top: 14px;
  height: 40px;
  min-height: 40px;
  padding: 0 18px;
  border-radius: 8px;
  background: var(--ui-primary, #165DFF);
  color: #FFFFFF;
  font-size: 13px;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.retry-button::after {
  display: none;
  border: none;
}
