page{height:100%;overflow:hidden;background:#f5f8f7;color:#234d43}.placement-page{width:100%;height:100vh;padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));max-width:850rpx;margin:auto;box-sizing:border-box;overflow:hidden;display:flex;flex-direction:column}
.heading{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:12rpx;min-height:44px;font-size:28rpx}.instruction{flex:0 0 auto;font-size:30rpx;margin:6rpx 0 12rpx}
.view-switch{position:relative;z-index:5;display:flex;flex:0 0 auto;height:44px;gap:4rpx;padding:3rpx;margin-bottom:10rpx;border-radius:12rpx;background:#e3ebe5;box-sizing:border-box}.view-tab{position:relative;z-index:6;flex:1;min-height:36px;padding:4rpx 8rpx;background:transparent;border-radius:9rpx}.view-tab.is-active{background:#fff;color:#215e4a;font-weight:600}
.placement-page .p9-split{display:flex;flex:1 1 0;min-width:0;min-height:0;flex-direction:column;align-items:stretch;overflow:hidden;width:100%}.placement-page.p9-photo-workflow .body-stage{position:relative;z-index:1;display:block;width:100%;box-sizing:border-box;flex:0 0 50vh;height:50vh;min-width:0;min-height:220px;max-height:620px;overflow:hidden}.body-canvas-slot{position:absolute;inset:0;width:100%;height:100%;min-width:0;min-height:0;overflow:hidden}.body-canvas-slot>body-canvas{display:block;width:100%;height:100%;min-width:0;min-height:0}.body-canvas-instance,.placement-canvas-instance{display:block;width:100%;height:100%;min-width:0;min-height:0}.stage-body-fallback{position:absolute;z-index:1;display:block;max-width:none;pointer-events:none}.stage-body-preview{position:absolute;inset:0;z-index:1;display:block;width:100%;height:100%;pointer-events:none}.overlay{position:absolute;inset:0;z-index:2;display:block;width:100%;height:100%;min-width:0;min-height:0}.overlay>placement-overlay{display:block;width:100%;height:100%;min-width:0;min-height:0}.p9-controls.placement-controls{flex:1 1 0;min-height:0;overflow-x:hidden;overflow-y:auto;-webkit-overflow-scrolling:touch}.warning .text-button{display:inline-flex;width:auto;margin:8rpx 0 0;padding:4rpx 0}
button{font-size:28rpx;line-height:1.4;min-height:44px;padding:10px 12px;border-radius:12rpx;color:#285a4d;background:#e6eeea;display:flex;align-items:center;justify-content:center;margin:0}button::after{border:0}button.primary{background:#236b57;color:white}button[disabled]{background:#edf0ee;color:#8d9c96}
button.text-button{background:transparent;font-size:26rpx;padding:8px 10px}.focus{margin:auto}.slider-label{display:flex;justify-content:space-between;font-size:27rpx;margin-top:10rpx}slider{margin:12rpx 12rpx 18rpx}.actions{display:flex;gap:16rpx;margin-top:16rpx}.actions button{flex:1}.actions .primary{flex:2}.note{font-size:23rpx;line-height:1.5;color:#7a8d84;margin-top:18rpx}.warning{font-size:26rpx;line-height:1.6;color:#975133;padding:12rpx 0}.saved{width:100%;margin-top:18rpx}

.stage-loading { position:absolute; left:50%; top:50%; z-index:1; padding:10rpx 16rpx; border-radius:10rpx; background:rgba(245,248,247,.88); color:#4f6b61; font-size:24rpx; transform:translate(-50%,-50%); pointer-events:none; }

/* Large phones in landscape, tablets and unfolded foldables use the P9
   two-column workspace. Page-level selectors are repeated here because the
   phone defaults above are intentionally more specific than generic P9 rules. */
@media (min-width:680px) and (min-height:520px){
 .placement-page.p9-page{max-width:1120px;padding-left:max(16px, env(safe-area-inset-left));padding-right:max(16px, env(safe-area-inset-right))}
 .placement-page .p9-split{flex-direction:row;align-items:stretch;gap:16px;min-height:0}
 .placement-page.p9-photo-workflow .body-stage{flex:5 1 0;width:auto;height:calc(100vh - 128px - env(safe-area-inset-bottom));min-height:0;max-height:740px}
 .placement-page .p9-controls.placement-controls{flex:3 1 0;min-width:260px;width:auto;max-height:calc(100vh - 128px - env(safe-area-inset-bottom));box-sizing:border-box;padding:10px;border-radius:12px;background:#f5f8f4;overflow-y:auto}
 .placement-page .focus{margin:0 0 8px}
}
