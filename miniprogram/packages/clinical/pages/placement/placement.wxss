page {
  height: 100%;
  overflow: hidden;
  background: var(--ui-bg-stage);
}

.placement-page {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  background: var(--ui-bg-stage);
}

.placement-workspace {
  flex: 1 1 0;
  min-width: 0;
  min-height: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 手机端类型 A：上方人体拖拽视口 flex:1（约 58%~62%） ===== */
.body-stage {
  position: relative;
  z-index: 1;
  flex: 1 1 0;
  min-width: 0;
  min-height: 240px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.stage-header {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 14px 2px;
  box-sizing: border-box;
}

.stage-context {
  flex: 1 1 0;
  min-width: 0;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  color: var(--ui-text-1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stage-switch-row {
  position: relative;
  z-index: 2;
  flex: 0 0 auto;
  display: flex;
  justify-content: center;
  margin: 2px auto 4px;
}

.view-segmented {
  width: 196px;
}

.view-tab {
  flex: 1 1 0;
}

.view-tab.is-disabled {
  opacity: 0.55;
  pointer-events: none;
}

/* 中间纯净画布区：严格零 padding/border */
.stage-canvas-frame {
  position: relative;
  flex: 1 1 0;
  height: 0;
  min-width: 0;
  min-height: 0;
  width: 100%;
  overflow: hidden;
}

.body-canvas-slot {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  padding: 0;
  border: 0;
  overflow: hidden;
}

.stage-body-fallback {
  position: absolute;
  z-index: 1;
  display: block;
  max-width: none;
  pointer-events: none;
}

.stage-body-preview {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: block;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  padding: 0;
  border: 0;
}

.overlay > placement-overlay,
.placement-canvas-instance {
  display: block;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
}

.stage-loading {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 3;
  padding: 6px 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid #E5E9F0;
  color: var(--ui-text-2);
  font-size: 12px;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.stage-bottom-bar {
  flex: 0 0 auto;
  height: 26px;
  padding: 0 14px 4px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  font-size: 11px;
  color: #64748B;
}

.stage-legend-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 2px 8px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid #E5E9F0;
  white-space: nowrap;
  flex-shrink: 0;
}

.lesion-key {
  width: 8px;
  height: 8px;
  border-radius: 2px;
  background: #D97706;
  flex-shrink: 0;
}

.stage-bottom-hint {
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ===== 手机端类型 A：下方紧凑参数区（贴合内容，上限 46vh 可滚） ===== */
.placement-inspector {
  position: relative;
  z-index: 2;
  flex: 0 0 auto;
  height: auto;
  max-height: 46vh;
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #FFFFFF;
  border-top: 1px solid #E5E9F0;
  border-radius: 16px 16px 0 0;
}

.placement-scroll {
  flex: 0 1 auto;
  min-height: 0;
  max-height: calc(46vh - 66px);
  width: 100%;
  overflow-y: auto;
}

.placement-scroll-inner {
  width: 100%;
  padding: 10px 16px 10px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* 顶部缩放切换工具条按钮（强制 100% 宽度覆盖 v2 button） */
.focus-tool-btn {
  margin: 0 !important;
  padding: 0 14px;
  width: 100% !important;
  min-width: 0 !important;
  max-width: none !important;
  height: 34px;
  min-height: 34px;
  line-height: 1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: #FFFFFF;
  border: 1px solid #CBD5E1;
  color: #1E293B;
  font-size: 13px;
  font-weight: 500;
}

.focus-tool-btn.is-focused {
  background: #EBF3FF;
  border-color: #165DFF;
  color: #165DFF;
  font-weight: 600;
}

.focus-tool-btn[disabled] {
  background: #F1F5F9;
  border-color: #E2E8F0;
  color: #94A3B8;
}

/* 紧凑参数卡 */
.param-card {
  width: 100%;
  box-sizing: border-box;
  border-radius: 10px;
  background: #FFFFFF;
  border: 1px solid #E5E9F0;
  overflow: hidden;
}

.param-group {
  padding: 8px 12px 4px;
}

.param-divider {
  height: 1px;
  background: #E5E9F0;
}

.slider-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.param-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--ui-text-1);
}

.param-badge {
  padding: 1px 8px;
  border-radius: 999px;
  background: #F1F5F9;
  color: var(--ui-text-1);
  font-size: 12px;
  font-weight: 600;
  line-height: 18px;
}

.param-slider {
  margin: 4px 4px 4px;
}

.hint-box {
  padding: 7px 10px;
  border-radius: 8px;
  background: #F1F5F9;
  color: var(--ui-text-2);
  font-size: 11px;
  line-height: 16px;
}

.placement-warning {
  padding: 8px 10px;
  border-radius: 8px;
  background: #FFFBEB;
  border: 1px solid #FDE68A;
  color: #92400E;
  font-size: 12px;
  line-height: 18px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
}

.retry-btn {
  height: 32px;
  min-height: 32px;
}

/* 吸底操作栏：左侧 38% 重置 + 右侧 62% 确认（强制覆盖 v2 button 宽度） */
.placement-footer {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
}

.reset-btn {
  flex: 38 1 0;
  width: 0 !important;
  min-width: 0 !important;
  max-width: none !important;
}

.confirm-btn {
  flex: 62 1 0;
  width: 0 !important;
  min-width: 0 !important;
  max-width: none !important;
}

.placement-footer-confirmed {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* ===== 宽屏 / 折叠屏模式：左 52% + 右 48% 饱满铺开 ===== */
@media (min-width: 680px) and (min-height: 520px) {
  .placement-workspace {
    flex-direction: row;
    align-items: stretch;
  }

  .body-stage {
    flex: 52 1 0;
    width: 0;
    height: 100%;
    min-height: 0;
    border-right: 1px solid #E5E9F0;
  }

  .stage-header {
    padding: 12px 20px 4px;
  }

  .stage-switch-row {
    margin: 4px auto 8px;
  }

  .view-segmented {
    width: 212px;
  }

  .stage-bottom-bar {
    height: 32px;
    padding: 0 20px 8px;
  }

  .placement-inspector {
    flex: 48 1 0;
    width: 0;
    height: 100%;
    max-height: none;
    border-top: none;
    border-radius: 0;
  }

  .placement-scroll {
    flex: 1 1 0;
    height: 0;
    max-height: none;
  }

  .placement-scroll-inner {
    padding: 20px 24px;
    gap: 14px;
  }

  .focus-tool-btn {
    height: 38px;
    min-height: 38px;
  }

  .param-group {
    padding: 14px 16px 8px;
  }

  .param-slider {
    margin: 10px 4px 6px;
  }

  .hint-box {
    padding: 10px 12px;
    font-size: 12px;
    line-height: 18px;
  }
}

/* 矮横屏兜底 */
@media (max-height: 519px) {
  .body-stage {
    min-height: 160px;
  }
}
