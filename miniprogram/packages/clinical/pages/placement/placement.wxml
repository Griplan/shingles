<view wx:if="{{!overlayReady && !error}}" class="placement-loading">正在加载人体与病灶范围…</view>
<view class="placement-page p9-page p9-photo-workflow">
 <view class="heading"><text>{{context}}</text><button class="text-button" bindtap="backPhoto">{{editingSaved ? '返回标注' : '返回照片'}}</button></view>
 <view class="view-switch"><button class="body-button view-tab {{view === 'front' ? 'is-active' : ''}}" data-view="front" disabled="{{confirmed || dragging || calculating}}" bindtap="switchView">正面</button><button class="body-button view-tab {{view === 'back' ? 'is-active' : ''}}" data-view="back" disabled="{{confirmed || dragging || calculating}}" bindtap="switchView">背面</button></view>
 <view class="instruction">{{calculating ? '正在计算参考对应，标注已保存…' : confirmed ? '位置已确认，已保存到本次标注' : '移动并调整病灶范围'}}</view>
 <view class="p9-split">
 <view class="body-stage p9-stage">
  <body-canvas view="{{view}}" zoom-region="{{zoomRegion}}" focus-bounds="{{focusBounds}}" annotation="{{layer}}" interaction-mode="readonly" touch-disabled="{{true}}" layout-revision="{{layoutRevision}}" bind:viewportchange="onViewport"></body-canvas>
  <placement-overlay id="placement-preview" wx:if="{{prepared && transform && !confirmed}}" class="overlay" view="{{view}}" prepared="{{prepared}}" transform="{{transform}}" viewport="{{viewport}}" revision="{{revision}}" interaction-key="{{interactionKey}}" disabled="{{dialog || !!error}}" bind:placementdrag="onDrag" bind:renderstate="onOverlayReady"></placement-overlay>
 </view>
 <view class="p9-controls">
 <button class="text-button focus" disabled="{{dragging || dialog}}" bindtap="toggleFocus">{{focusBounds ? '查看全身' : '放大病灶范围'}}</button>
 <view wx:if="{{error}}" class="warning">{{error}}</view>
 <view wx:elif="{{message}}" class="warning">{{message}}</view>
 <block wx:if="{{!confirmed && !error}}">
  <view class="slider-label"><text>调整大小</text><text>{{scalePercent}}%</text></view>
  <slider min="10" max="400" step="1" value="{{scalePercent}}" activeColor="#28735c" disabled="{{dialog || dragging}}" bindtouchstart="startSlider" bindchanging="scaleChanging" bindchange="scaleChanged"/>
  <view class="slider-label"><text>调整方向</text><text>{{angle}}°</text></view>
  <slider min="-180" max="180" step="1" value="{{angle}}" activeColor="#28735c" disabled="{{dialog || dragging}}" bindtouchstart="startSlider" bindchanging="angleChanging" bindchange="angleChanged"/>
  <view class="actions"><button bindtap="reset" disabled="{{dialog || dragging}}">重置调整</button><button class="primary" disabled="{{(!valid && !needsClip) || !viewport || !overlayReady || dragging || dialog || calculating}}" bindtap="confirmPosition">{{needsClip ? '检查越界并确认' : '确认位置'}}</button></view>
  <view class="note">按住橙色范围拖动调整；尺寸和方向仅影响本次放置。</view>
 </block>
 <block wx:if="{{confirmed}}"><button class="primary saved" loading="{{calculating}}" disabled="{{opening || calculating}}" bindtap="confirmPosition">{{calculating ? '计算中…' : '查看结果 / 重试计算'}}</button><button class="text-button" disabled="{{opening || calculating}}" bindtap="viewAnnotations">查看已保存标注</button></block>
 </view>
 </view>
</view>
