.atlas-page { padding: 12px 16px calc(24px + env(safe-area-inset-bottom)); max-width: 720px; margin: 0 auto; box-sizing: border-box; }
.preview-warning { background: #FFFBEB; border: 1px solid #FDE68A; color: #92400E; padding: 8px 12px; border-radius: 8px; font-size: 12px; }
.toolbar { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin: 8px 0; }
.segments { display: flex; gap: 6px; }
.segments button, .actions button { margin: 0; padding: 0 10px; height: 32px; line-height: 30px; background: #FFFFFF; border: 1px solid #CBD5E1; color: #1E293B; font-size: 12px; border-radius: 6px; }
.segments button::after, .actions button::after, .face-options button::after { display: none; border: none; }
.segments button.active { background: #165DFF; border-color: #165DFF; color: #FFFFFF; }
.canvas-area { position: relative; height: 54vh; min-height: 320px; background: #F4F6F9; border-radius: 10px; border: 1px solid #E5E9F0; overflow: hidden; }
.canvas-area body-canvas { display: block; width: 100%; height: 100%; }
.side-guide { position: absolute; left: 12px; right: 12px; top: 8px; display: flex; justify-content: space-between; font-size: 11px; color: #64748B; pointer-events: none; }
.controls { font-size: 13px; }
.region-selector { display: flex; justify-content: space-between; margin-top: 10px; background: #FFFFFF; border: 1px solid #CBD5E1; padding: 10px 12px; border-radius: 8px; color: #111827; }
.label-switch { display: flex; align-items: center; font-size: 12px; white-space: nowrap; color: #4B5563; }
.label-switch switch { transform: scale(0.7); transform-origin: right center; }
.coverage, .message { font-size: 12px; color: #64748B; margin-top: 6px; }
.source-toggle { padding: 10px 0; color: #165DFF; font-weight: 500; }
.source-info { font-size: 12px; line-height: 1.65; background: #FFFFFF; border: 1px solid #E5E9F0; border-radius: 8px; padding: 12px; word-break: break-all; color: #4B5563; }
.source-info view { margin: 6px 0; }
.back-link { color: #165DFF; padding-top: 10px; font-size: 13px; }
.group-tabs { margin-top: 10px; flex-wrap: wrap; }
.face-options { display: flex; flex-direction: column; gap: 6px; margin-top: 8px; }
.face-options button { margin: 0; text-align: left; padding: 0 12px; height: 34px; line-height: 32px; background: #FFFFFF; border: 1px solid #E5E9F0; color: #1E293B; font-size: 12px; border-radius: 6px; }
.face-options button.active { background: #165DFF; border-color: #165DFF; color: #FFFFFF; }
