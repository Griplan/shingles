/* 工作流共用间距与颜色；控件反馈与Canvas透明度分别处理。 */
page{height:100%;overflow:hidden}
.annotation-page{--green:#236653;--muted:#63766d;--gap:6px;--radius:9px;width:100%;max-width:600px;height:100vh;margin:0 auto;padding:8px 8px calc(8px + env(safe-area-inset-bottom));box-sizing:border-box;overflow:hidden;display:flex;flex-direction:column;color:#203d35;background:#f4f8f6}
.control{min-width:0;margin:0!important;padding:7px 6px;font-size:13px;line-height:24px;min-height:40px;border-radius:var(--radius);background:#e6eee9;color:#315c4d;transition:background-color var(--feedback-ms,120ms)}
.control::after{border:0}.primary{background:var(--green);color:white}
.heading{flex:0 0 42px;display:flex;align-items:center;justify-content:space-between;height:42px;font-size:18px;font-weight:600}.heading .control{width:auto!important;min-width:54px}.info-link{width:auto!important;background:transparent;font-size:13px;min-width:54px}
.switch-row{position:relative;z-index:5;flex:0 0 auto;display:flex;gap:4px;height:40px;background:#e6eee9;border-radius:var(--radius);padding:2px;box-sizing:border-box}.tab{position:relative;z-index:6;flex:1;min-height:36px;padding:5px;background:transparent}.tab.active{background:white;color:var(--green)}
.scope-row{flex:0 0 44px;height:44px;white-space:nowrap}.scope-items{display:flex;align-items:center;gap:4px;padding:3px 0}.chip{flex:0 0 auto;width:auto!important;font-size:12px;padding:5px 10px;min-height:36px}.selected{background:#dcece3;color:#204f3e}
.status{flex:0 0 24px;height:24px;line-height:22px;color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden}
.p9-split{display:flex;flex:1 1 0;width:100%;min-width:0;min-height:0;box-sizing:border-box;flex-direction:column;overflow:hidden}
.result-stage{position:relative;z-index:1;flex:0 0 auto;display:flex;width:100%;min-width:0;box-sizing:border-box;gap:3px;align-items:stretch;background:#faf8f4;border-radius:var(--radius);overflow:hidden}
.canvas-area{position:relative;flex:1 1 0;width:auto;min-width:0;height:100%;overflow:hidden}.canvas-area>body-canvas{display:block;width:100%;height:100%;min-width:0;min-height:0}.rail{width:72px;flex:0 0 72px;overflow:hidden;background:#f5f8f4}.rail-title{height:24px;line-height:24px;text-align:center;font-size:11px;color:#63766d}
.rail-content{position:relative;opacity:0;transition-property:opacity;transition-timing-function:ease-out}.rail-content.shown{opacity:1}
.rail .nerve-label{position:absolute;left:1px;width:calc(100% - 2px);height:44px;min-height:44px;padding:3px 3px 3px 5px;border:1px solid #dde6df;border-left:4px solid;box-sizing:border-box;background:white;line-height:17px;text-align:left}.rail .nerve-label.selected{background:#e1eee6;border-top-color:#64927b;border-bottom-color:#64927b;border-right-color:#64927b}
.label-name{display:block;font-size:12px;font-weight:600;white-space:normal;overflow-wrap:anywhere}.label-ratio{display:block;font-size:11px;line-height:15px;color:var(--muted)}.rail-hint{height:20px;line-height:20px;font-size:10px;text-align:center;color:var(--muted)}
.legend{display:flex;gap:5px;align-items:center;height:26px;font-size:11px;color:var(--muted)}.lesion-key{width:11px;height:8px;border:2px solid #ac5239}.atlas-key{width:12px;height:11px;background:#a5cbbe;margin-left:6px}
.view-tools{display:flex;height:42px;gap:4px}.view-tools .control{flex:1;min-height:40px}.subtle{background:transparent;font-size:12px}
.p9-controls.result-controls{flex:1 1 0;min-height:0;overflow-x:hidden;overflow-y:auto;-webkit-overflow-scrolling:touch}.action-area{min-height:90px}.selection-caption{height:36px;font-size:12px;line-height:18px;overflow-y:auto}.toolbar{display:flex;gap:var(--gap);height:44px}.toolbar .control{flex:1;height:44px}
.reference-note{font-size:11px;color:var(--muted);line-height:22px}.summary{font-size:12px;line-height:20px;padding-top:4px}.empty-result{font-weight:600;color:#486257}.message{font-size:12px;color:#974b36;line-height:18px;padding:5px 0;overflow-wrap:anywhere}.error-state{padding:30px;font-size:14px;line-height:24px}
.info-mask{position:fixed;inset:0;z-index:100;background:rgba(24,44,35,.3);display:flex;align-items:flex-end}.info-sheet{width:100%;max-width:600px;margin:0 auto;background:#f8faf7;border-radius:16px 16px 0 0;padding:12px 16px calc(12px + env(safe-area-inset-bottom));box-sizing:border-box}.info-scroll{height:66vh;font-size:13px;line-height:21px;overflow-wrap:anywhere}.info-title{font-weight:600;margin-top:18px}.info-paragraph{margin:10px 0}.source-url{display:block;font-size:12px;overflow-wrap:anywhere}.copy{margin:8px 0;font-size:12px}.setting-row{display:flex;align-items:center;justify-content:space-between;margin:12px 0}
@media(max-width:350px){.rail{width:64px}.rail-title{font-size:10px}.rail-hint{font-size:9px}.legend{font-size:10px}.label-name{font-size:11px}}
.result-stage{height:var(--phone-stage,360px);max-width:100%}
@media (min-width:680px) and (min-height:520px){
 .annotation-page.p9-page{max-width:1120px}
 .annotation-page .p9-split{display:flex;flex-direction:row;align-items:flex-start;gap:16px}
 /* The desktop media query must restore the result stage as a flex-sized
    sibling. The phone rule intentionally uses flex:0 0 auto, and leaving it
    here makes the intrinsic-width stage collapse once the canvas basis is 0. */
 .annotation-page .result-stage{flex:5 1 0;width:0;min-width:0;height:var(--p9-stage-height);max-height:calc(100vh - 120px - env(safe-area-inset-bottom))}
 .annotation-page .p9-controls.result-controls{max-height:var(--p9-stage-height);overflow-y:auto}
 .p9-scope .scope-items{flex-wrap:wrap}
}
