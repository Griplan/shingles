<view class="ai-page">
  <!-- 离屏照片预处理画布：严格保留 id 与 wx:if 挂载逻辑 -->
  <canvas wx:if="{{preparing}}" type="2d" id="prepare-photo-canvas" class="prepare-photo-canvas" aria-hidden="true"></canvas>

  <view class="ai-workspace {{photo ? 'has-photo' : 'is-empty'}}">
    <!-- 左侧(宽屏52%) / 上方(手机空态 flex:1 吃满；识别态 42%)：固定照片视口 -->
    <view class="photo-stage ui-stage-grid">
      <view class="stage-header">
        <text class="stage-context">{{context}}</text>
        <view
          wx:if="{{photo}}"
          class="ui-top-pill {{(preparing || phase === 'uploading') ? 'is-disabled' : ''}}"
          hover-class="ui-hover-secondary"
          aria-role="button"
          bindtap="changePhoto"
        >更换照片</view>
      </view>

      <view class="photo-viewport">
        <view wx:if="{{photo}}" class="photo-canvas-wrap">
          <photo-canvas
            source="{{photo}}"
            mask="{{mask}}"
            photo-width="{{photoWidth}}"
            photo-height="{{photoHeight}}"
            mode="{{mode}}"
            points="{{points}}"
            box="{{box}}"
            additional-boxes="{{additionalBoxes}}"
            brush-radius="{{brushRadius}}"
            show-prompts="{{selecting || adjusting}}"
            layout-revision="{{layoutRevision}}"
            disabled="{{preparing || phase === 'confirming' || phase === 'confirmed' || phase === 'correcting' || previewing || pendingBrush || (!selecting && !adjusting && !editingMask)}}"
            bind:prompt="onPrompt"
            bind:stroke="onStroke"
            bind:strokeinvalid="strokeInvalid"
            bind:boxinvalid="boxInvalid"
            bind:renderstate="renderState"
          ></photo-canvas>
        </view>

        <!-- 上传空态：白底 + 1.5px 精密虚线取景框 -->
        <view wx:else class="placeholder-frame">
          <view class="placeholder-icon" aria-hidden="true">
            <view class="viewfinder-corner tl"></view>
            <view class="viewfinder-corner tr"></view>
            <view class="viewfinder-corner bl"></view>
            <view class="viewfinder-corner br"></view>
            <view class="viewfinder-lens"></view>
          </view>
          <text class="placeholder-title">{{preparing ? '正在准备照片…' : phase === 'uploading' ? '正在上传…' : '上传一张局部照片'}}</text>
          <text class="placeholder-sub">{{preparing || phase === 'uploading' ? '请稍候' : '圈选目标区域，自动提取轮廓'}}</text>
        </view>
      </view>
    </view>

    <!-- 右侧(宽屏48%) / 下方(手机空态贴合内容；识别态 flex:1 独立滚动) -->
    <view class="ai-inspector">
      <!-- 空态上传操作区：手机端贴合内容零留白 -->
      <view wx:if="{{!photo}}" class="empty-inspector-body">
        <view wx:if="{{!available}}" class="ai-notice">当前仅开放测试图片体验，可返回手动标注。</view>
        <view class="empty-wide-header">
          <view class="empty-section-title">选择照片来源</view>
          <view class="empty-section-sub">请选择清晰的局部照片，圈选后自动提取轮廓</view>
        </view>
        <view class="upload-actions">
          <button
            class="ui-btn ui-btn-primary upload-btn"
            hover-class="ui-hover-primary"
            disabled="{{!available || preparing || phase === 'uploading'}}"
            loading="{{preparing || phase === 'uploading'}}"
            data-source="album"
            bindtap="pickPhoto"
          >从相册选择</button>
          <button
            class="ui-btn ui-btn-secondary upload-btn"
            hover-class="ui-hover-secondary"
            disabled="{{!available || preparing || phase === 'uploading'}}"
            data-source="camera"
            bindtap="pickPhoto"
          >拍照</button>
        </view>
        <view wx:if="{{preparationError}}" class="ai-warning" aria-live="polite">{{preparationError}}</view>
        <view wx:if="{{error && error !== noUsableContourMessage}}" class="ai-warning">{{error}}</view>
        <view wx:if="{{cleanupWarning}}" class="ai-warning">{{cleanupWarning}}</view>
      </view>

      <!-- 有照片后的独立滚动控制区 -->
      <scroll-view wx:else class="ai-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="ai-scroll-inner">
          <view wx:if="{{!available}}" class="ai-notice">当前仅开放测试图片体验，可返回手动标注。</view>

          <view wx:if="{{preparing}}" class="status-banner" aria-live="polite">
            <text class="status-dot"></text>
            <text class="status-text">正在准备照片…</text>
          </view>

          <block wx:if="{{!preparing}}">
            <!-- 第 1 层：状态提示条 -->
            <view class="status-banner" aria-live="polite">
              <text class="status-dot {{failed ? 'is-warn' : ''}}"></text>
              <view class="status-text">
                <text wx:if="{{phase === 'confirmed'}}">{{hasPendingPlacement ? '上次的位置调整已在本次运行中暂存，可继续放置。' : '照片中的轮廓已确认，请继续确认人体位置。'}}</text>
                <text wx:elif="{{phase === 'confirming'}}">正在确认…</text>
                <text wx:elif="{{phase === 'correcting'}}">正在应用修正，照片会保持显示…</text>
                <text wx:elif="{{working}}">{{previewing ? '正在切换候选轮廓…' : '正在处理图片…'}}</text>
                <text wx:elif="{{editingMask}}">{{mode === 'paint-add' ? '涂过需要补充的范围，松手后应用' : '涂过误选的区域，松手后擦除'}}</text>
                <text wx:elif="{{addingRegion}}">再框住一处需要提取轮廓的区域。</text>
                <text wx:elif="{{failed}}">轮廓提取失败，请重新圈选。</text>
                <text wx:elif="{{adjusting}}">{{mode === 'foreground' ? '轻点需要补充的位置' : '轻点需要排除的位置'}}</text>
                <text wx:elif="{{hasResult}}">轮廓提取完成（自动化图像分割），请检查绿色范围，再确认。</text>
                <text wx:else>请框住所需的目标区域。</text>
              </view>
            </view>

            <view wx:for="{{warnings}}" wx:key="*this" class="ai-warning">{{item}}</view>

            <block wx:if="{{phase !== 'confirmed'}}">
              <!-- 画笔修正模式 -->
              <view wx:if="{{editingMask}}" class="submode-card">
                <view class="ui-segmented submode-segmented">
                  <view
                    class="ui-segmented-item submode-tab {{mode === 'paint-add' ? 'is-active' : ''}} {{working ? 'is-disabled' : ''}}"
                    hover-class="ui-hover-subtle"
                    aria-role="button"
                    data-mode="paint-add"
                    bindtap="brushMode"
                  >补充区域</view>
                  <view
                    class="ui-segmented-item submode-tab {{mode === 'paint-erase' ? 'is-active' : ''}} {{working ? 'is-disabled' : ''}}"
                    hover-class="ui-hover-subtle"
                    aria-role="button"
                    data-mode="paint-erase"
                    bindtap="brushMode"
                  >擦除误选</view>
                </view>

                <view class="brush-size-card">
                  <view class="brush-size-header">
                    <text class="brush-size-label">画笔大小</text>
                    <text class="brush-size-val ui-num">{{brushSize}}</text>
                  </view>
                  <slider
                    class="brush-slider"
                    min="5"
                    max="60"
                    value="{{brushSize}}"
                    disabled="{{working}}"
                    activeColor="#165DFF"
                    backgroundColor="#E2E8F0"
                    block-size="20"
                    bindchange="brushSizeChanged"
                  />
                </view>

                <view class="submode-row">
                  <button class="ui-btn ui-btn-secondary ui-btn-sm submode-btn" hover-class="ui-hover-secondary" disabled="{{!canUndoBrush || working || pendingBrush}}" bindtap="undoBrush">撤销</button>
                  <button class="ui-btn ui-btn-secondary ui-btn-sm submode-btn" hover-class="ui-hover-secondary" disabled="{{working}}" bindtap="restoreBrush">恢复原轮廓</button>
                </view>

                <button wx:if="{{pendingBrush}}" class="ui-btn ui-btn-primary ui-btn-block" hover-class="ui-hover-primary" disabled="{{working}}" bindtap="retryBrush">重试本次修正</button>
                <button wx:else class="ui-btn ui-btn-primary ui-btn-block" hover-class="ui-hover-primary" disabled="{{working || !renderReady}}" bindtap="finishBrush">完成修正</button>
              </view>

              <!-- 精细点选调整模式 -->
              <view wx:elif="{{adjusting}}" class="submode-card">
                <view class="ui-segmented submode-segmented">
                  <view
                    class="ui-segmented-item submode-tab {{mode === 'foreground' ? 'is-active' : ''}}"
                    hover-class="ui-hover-subtle"
                    aria-role="button"
                    data-mode="foreground"
                    bindtap="setMode"
                  >补充目标区域</view>
                  <view
                    class="ui-segmented-item submode-tab {{mode === 'background' ? 'is-active' : ''}}"
                    hover-class="ui-hover-subtle"
                    aria-role="button"
                    data-mode="background"
                    bindtap="setMode"
                  >排除误选区域</view>
                </view>

                <view class="submode-row">
                  <button class="ui-btn ui-btn-secondary ui-btn-sm submode-btn" hover-class="ui-hover-secondary" disabled="{{!canUndo}}" bindtap="undo">撤销</button>
                  <button class="ui-btn ui-btn-primary ui-btn-sm submode-btn" hover-class="ui-hover-primary" disabled="{{!hasPrompt || working}}" bindtap="refine">重新提取</button>
                </view>

                <view class="tool-grid">
                  <button class="tool-grid-btn" hover-class="ui-hover-secondary" disabled="{{working || additionalBoxes.length >= 3}}" bindtap="addRegion">补圈一处</button>
                  <button class="tool-grid-btn" hover-class="ui-hover-secondary" disabled="{{working || additionalBoxes.length > 0}}" bindtap="alternativeAnalysis">{{strategy === 'context_crop' ? '改用整图提取' : '改用局部提取'}}</button>
                </view>
                <text class="submode-muted">局部提取仅处理圈选附近，圈外目标可补圈。重新提取会替换本次画笔修正。</text>
              </view>

              <!-- 标准 AI 识别确认态：唯一主 CTA + 2x2 微调工具盒 -->
              <block wx:else>
                <button
                  wx:if="{{hasResult}}"
                  class="ui-btn ui-btn-primary ui-btn-block confirm-cta"
                  hover-class="ui-hover-primary"
                  disabled="{{!canConfirm || !renderReady}}"
                  loading="{{phase === 'confirming'}}"
                  bindtap="confirm"
                >确认轮廓</button>

                <view wx:if="{{box || failed || hasResult}}" class="toolbox-card">
                  <view class="toolbox-title">轮廓不合适？可微调范围</view>
                  <view class="tool-grid">
                    <button class="tool-grid-btn" hover-class="ui-hover-secondary" disabled="{{phase === 'confirming'}}" bindtap="reselect">重新圈选</button>
                    <button wx:if="{{canCycle}}" class="tool-grid-btn" hover-class="ui-hover-secondary" disabled="{{phase === 'confirming'}}" bindtap="nextResult">换个候选轮廓</button>
                    <button wx:if="{{hasResult && !working && phase === 'ready'}}" class="tool-grid-btn" hover-class="ui-hover-secondary" bindtap="openBrush">修正范围</button>
                    <button wx:if="{{hasResult && !working && phase === 'ready'}}" class="tool-grid-btn" hover-class="ui-hover-secondary" bindtap="openAdjustment">精细调整</button>
                  </view>
                </view>
              </block>
            </block>

            <!-- 已确认轮廓态 -->
            <view wx:else class="confirmed-actions">
              <button
                class="ui-btn ui-btn-primary ui-btn-block confirm-cta"
                hover-class="ui-hover-primary"
                loading="{{openingPlacement}}"
                disabled="{{openingPlacement}}"
                bindtap="placeOnBody"
              >{{hasPendingPlacement ? '继续放置到人体' : '放置到人体'}}</button>
              <button class="ui-btn ui-btn-secondary ui-btn-sm ui-btn-block" hover-class="ui-hover-secondary" bindtap="reselect">{{hasPendingPlacement ? '重新选择照片' : '重新圈选'}}</button>
            </view>
          </block>

          <view wx:if="{{preparationError}}" class="ai-warning" aria-live="polite">{{preparationError}}</view>
          <view wx:if="{{error && error !== noUsableContourMessage}}" class="ai-warning">{{error}}</view>
          <view wx:if="{{cleanupWarning}}" class="ai-warning">{{cleanupWarning}}</view>
        </view>
      </scroll-view>

      <!-- 第 4 层：吸底危险 / 退出与隐私区 -->
      <view class="ui-sticky-footer ai-footer">
        <button
          wx:if="{{photo || preparing || phase === 'uploading'}}"
          class="ui-btn ui-btn-danger ui-btn-sm ui-btn-block cancel-photo-btn"
          hover-class="ui-hover-danger"
          bindtap="cancel"
        >取消并删除照片</button>
        <view class="footer-links">
          <view class="footer-link-btn" hover-class="ui-hover-ghost" aria-role="button" bindtap="backManual">返回手动标注</view>
          <text class="footer-sep" aria-hidden="true">·</text>
          <view class="footer-link-btn" hover-class="ui-hover-ghost" aria-role="button" bindtap="showPrivacy">照片用途与隐私</view>
        </view>
        <view class="privacy-note">提取的轮廓需自行确认，仅供位置标注参考，不作为医疗诊断依据。</view>
      </view>
    </view>
  </view>
</view>
