<view class="special-page">
  <view class="special-header">
    <view class="title">选择特殊部位</view>
    <view class="hint">选择部位并圈选需要观察的范围。手部请在全身正面或背面标注。</view>
  </view>

  <view class="choices">
    <button class="choice" data-view="sole-left" bindtap="choose" disabled="{{opening}}">
      <text class="choice-title">左脚底</text>
      <text class="choice-desc">足跟、足弓与跖侧脚趾</text>
    </button>
    <button class="choice" data-view="sole-right" bindtap="choose" disabled="{{opening}}">
      <text class="choice-title">右脚底</text>
      <text class="choice-desc">足跟、足弓与跖侧脚趾</text>
    </button>
  </view>

  <view class="choices">
    <button class="choice" data-view="axilla-left" bindtap="choose" disabled="{{opening}}">
      <text class="choice-title">左腋下</text>
      <text class="choice-desc">抬臂圈选 · 参考图谱待配置</text>
    </button>
    <button class="choice" data-view="axilla-right" bindtap="choose" disabled="{{opening}}">
      <text class="choice-title">右腋下</text>
      <text class="choice-desc">抬臂圈选 · 参考图谱待配置</text>
    </button>
  </view>

  <view class="choices single">
    <button class="choice" data-view="perineum-overview" bindtap="choose" disabled="{{opening}}">
      <text class="choice-title">会阴区域</text>
      <text class="choice-desc">中性示意 · 人为模拟分区 · 人工标注</text>
    </button>
  </view>

  <view wx:if="{{message}}" class="message">{{message}}</view>

  <view class="special-footer">
    <button class="ui-btn ui-btn-secondary ui-btn-block back" bindtap="returnBody">返回全身人体</button>
  </view>
</view>
