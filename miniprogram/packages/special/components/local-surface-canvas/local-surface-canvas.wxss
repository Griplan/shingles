:host {
  display: block;
  width: 100%;
  height: 100%;
}

.canvas-shell {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--ui-bg-stage, #F4F6F9);
}

.local-surface-canvas {
  width: 100%;
  height: 100%;
}

.canvas-message {
  position: absolute;
  left: 16px;
  right: 16px;
  top: 40%;
  text-align: center;
  font-size: 13px;
  color: #64748B;
}

.canvas-message button {
  margin-top: 12px;
  height: 36px;
  line-height: 34px;
  padding: 0 14px;
  border-radius: 8px;
  font-size: 13px;
  background: #FFFFFF;
  border: 1px solid #CBD5E1;
  color: #1E293B;
}

.canvas-message button::after {
  display: none;
  border: none;
}
